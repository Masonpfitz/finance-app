# Copy this file to .env (the setup screen does it for you), then fill in the blanks.
# Never share your .env file or post it anywhere. It holds your Plaid secret.

# From dashboard.plaid.com, under Developers, then Keys.
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here

# "sandbox" is fake banks for testing (login user_good / pass_good).
# "production" is your real bank. Use the secret that matches.
PLAID_ENV=sandbox

# Turn on demo mode (made-up accounts and transactions). Leave blank to use the
# switch on the setup screen instead.
DEMO_MODE=

# The app only listens on your own computer.
PORT=3000

# Daily sync time, 24-hour clock, your computer's local time. 6 means 6 AM.
SYNC_HOUR=6

# Optional. Adds an AI pass that guesses categories for transactions the built-in
# rules can't place. The app works fully without it. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
