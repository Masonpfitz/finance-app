{
  "name": "finance-app",
  "version": "1.0.0",
  "private": true,
  "description": "A private finance dashboard that runs on your own computer. Reads balances and transactions through Plaid (read-only) and keeps everything in one local file.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "dev": "node scripts/launch.mjs --dev",
    "build": "next build",
    "sync": "node scripts/sync-cli.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/launch.mjs --demo",
    "check:security": "node scripts/check-security.mjs",
    "sandbox-check": "node scripts/sandbox-check.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "15.5.28",
    "plaid": "^42.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
